{
  "name": "fertig",
  "version": "1.1.0",
  "description": "A classless CSS stylesheet with no legacy in it: no prefixes, no polyfills, no classes. Link one file, write ordinary HTML, done — 8.4 KB gzipped, no build step, no dependencies.",
  "keywords": [
    "fertig",
    "fertig.css",
    "css",
    "classless",
    "classless-css",
    "css-framework",
    "stylesheet",
    "minimal",
    "design-system",
    "color-palette",
    "oklch",
    "dark-mode",
    "light-dark",
    "semantic-html",
    "logical-properties",
    "bidirectional",
    "rtl",
    "no-build",
    "prototyping",
    "lightweight",
    "minimalist",
    "html",
    "frontend",
    "ui",
    "responsive"
  ],
  "license": "MIT",
  "author": "Mojtaba Beheshti <info@rublex.io>",
  "homepage": "https://moji2002.github.io/fertig/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moji2002/fertig.git"
  },
  "bugs": {
    "url": "https://github.com/moji2002/fertig/issues"
  },
  "main": "fertig.css",
  "style": "fertig.css",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./fertig.css",
    "./min": "./fertig.min.css",
    "./core": "./fertig.core.min.css",
    "./fertig.css": "./fertig.css",
    "./fertig.min.css": "./fertig.min.css",
    "./fertig.core.min.css": "./fertig.core.min.css",
    "./package.json": "./package.json"
  },
  "files": [
    "fertig.css",
    "fertig.min.css",
    "fertig.core.min.css",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.js",
    "dev": "python3 -m http.server 8899",
    "prepublishOnly": "node build.js",
    "sizes": "python3 tools/sizes.py"
  }
}
