{
  "name": "fertig",
  "version": "5.0.0",
  "description": "A classless CSS stylesheet with no legacy: link one file, write ordinary HTML, done. No build step, no dependencies.",
  "keywords": [
    "fertig",
    "fertig.css",
    "css",
    "classless",
    "classless-css",
    "css-framework",
    "stylesheet",
    "minimal",
    "design-system",
    "color-palette",
    "oklch",
    "dark-mode",
    "light-dark",
    "semantic-html",
    "logical-properties",
    "bidirectional",
    "rtl",
    "no-build",
    "prototyping",
    "lightweight",
    "minimalist",
    "html",
    "frontend",
    "ui",
    "responsive"
  ],
  "license": "MIT",
  "author": "Mojtaba Beheshti <info@rublex.io>",
  "homepage": "https://moji2002.github.io/fertig/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moji2002/fertig.git"
  },
  "bugs": {
    "url": "https://github.com/moji2002/fertig/issues"
  },
  "main": "fertig.css",
  "style": "fertig.css",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./fertig.css",
    "./min": "./fertig.min.css",
    "./classes": "./fertig-classes.css",
    "./classes/min": "./fertig-classes.min.css",
    "./themes": "./fertig-themes.css",
    "./themes/min": "./fertig-themes.min.css",
    "./fertig.css": "./fertig.css",
    "./fertig.min.css": "./fertig.min.css",
    "./fertig-classes.css": "./fertig-classes.css",
    "./fertig-classes.min.css": "./fertig-classes.min.css",
    "./fertig-themes.css": "./fertig-themes.css",
    "./fertig-themes.min.css": "./fertig-themes.min.css",
    "./package.json": "./package.json"
  },
  "files": [
    "fertig.css",
    "fertig.min.css",
    "fertig-classes.css",
    "fertig-classes.min.css",
    "fertig-themes.css",
    "fertig-themes.min.css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "build": "node build.js",
    "check": "npm run check:release && npm run check:sizes && npm test && npm run check:site && npm run check:package",
    "check:release": "node tools/sync-release.js --check && node tools/check-release.js",
    "check:sizes": "python3 tools/sizes.py --check",
    "check:site": "npm run site && node tools/check-site.js",
    "check:package": "npm pack --dry-run --ignore-scripts",
    "hooks:install": "git config core.hooksPath .githooks",
    "release:sync": "node tools/sync-release.js",
    "site:prepare": "node tools/prepare-site.mjs",
    "site": "npm run site:prepare && astro build",
    "site:serve": "npm run site:prepare && astro dev",
    "dev": "npm run site:serve",
    "prepublishOnly": "node build.js && npm run check:release && npm run check:sizes",
    "sizes": "python3 tools/sizes.py"
  },
  "devDependencies": {
    "astro": "^5.18.2"
  }
}
