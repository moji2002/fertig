<script>
// The snippet is generated from the preview, so the two can never disagree.
const tidy = html => {
  const lines = html.replace(/\t/g, '  ').split('\n');
  const indents = lines.filter(l => l.trim()).map(l => l.match(/^ */)[0].length);
  const cut = Math.min(...indents);
  return lines.map(l => l.slice(cut)).join('\n').trim();
};
document.querySelectorAll('.block').forEach(block => {
  const preview = block.querySelector('.block-preview');
  const code = block.querySelector('.block-code code');  // scoped: a description may contain <code> too
  code.textContent = tidy(preview.innerHTML);
  code.classList.add("language-html");
  if (window.hljs) hljs.highlightElement(code);
  const copy = document.createElement('button');
  copy.type = 'button';
  copy.dataset.size = 'sm';
  copy.innerHTML = '<svg class="icon" aria-hidden="true"><use href="icons.svg#copy"></use></svg>Copy';
  copy.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(code.textContent);
      copy.innerHTML = '<svg class="icon" aria-hidden="true"><use href="icons.svg#check"></use></svg>Copied';
    } catch {
      getSelection().selectAllChildren(code);
      copy.textContent = 'Selected — copy';
    }
    setTimeout(() => (copy.innerHTML = '<svg class="icon" aria-hidden="true"><use href="icons.svg#copy"></use></svg>Copy'), 1400);
  });
  block.querySelector('.block-code').append(copy);  // not prepend: <summary> must stay first
});
</script>
