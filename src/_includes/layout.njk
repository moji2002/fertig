<!doctype html>
<html lang="en">
<meta charset="utf-8">
<link rel="icon" href="favicon.svg" type="image/svg+xml">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="https://moji2002.github.io/fertig/{% if canonical %}{{ canonical }}{% endif %}">
<meta name="theme-color" content="#111315" media="(prefers-color-scheme: dark)">
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">

<meta property="og:type" content="website">
<meta property="og:site_name" content="fertig">
<meta property="og:url" content="https://moji2002.github.io/fertig/{{ canonical }}">
<meta property="og:title" content="{{ ogTitle or title }}">
<meta property="og:description" content="{{ ogDescription or description }}">
<meta property="og:image" content="https://moji2002.github.io/fertig/preview-dark.png">
{% if ogImageAlt %}<meta property="og:image:alt" content="{{ ogImageAlt }}">{% endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ ogTitle or title }}">
<meta name="twitter:description" content="{{ ogDescription or description }}">
<meta name="twitter:image" content="https://moji2002.github.io/fertig/preview-dark.png">

{% if schema %}
<script type="application/ld+json">
{{ schema | safe }}
</script>
{% endif %}
<script>
  /* before first paint: dark by default, or whatever was chosen last time.
     Inline and synchronous on purpose — a deferred script would repaint. */
  try {
    document.documentElement.dataset.theme =
      localStorage.getItem("fertig-theme") || "dark";
  } catch { document.documentElement.dataset.theme = "dark" }
</script>
<link rel="stylesheet" href="fertig.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="site.css">
<div class="reading-progress" aria-hidden="true"></div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.10.0/highlight.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.10.0/languages/xml.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.10.0/languages/css.min.js"></script>
{% for lang in langs %}<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.10.0/languages/{{ lang }}.min.js"></script>
{% endfor %}<script src="site.js" defer></script>

<nav>
  <div class="bar wrap">
    <strong><a href="index.html"><img src="favicon.svg" alt="" width="16" height="16" class="mark">fertig</a></strong>
    <ul>
      <li><a href="index.html"{% if active == 'index' %} aria-current="page"{% endif %}><svg class="icon" aria-hidden="true"><use href="icons.svg#zap"></use></svg>Home</a></li>
      <li><a href="index.html#customize"{% if active == 'customize' %} aria-current="page"{% endif %}><svg class="icon" aria-hidden="true"><use href="icons.svg#palette"></use></svg>Customise</a></li>
      <li><a href="docs.html"{% if active == 'docs' %} aria-current="page"{% endif %}><svg class="icon" aria-hidden="true"><use href="icons.svg#book-open"></use></svg>Docs</a></li>
      <li><a href="blocks.html"{% if active == 'blocks' %} aria-current="page"{% endif %}><svg class="icon" aria-hidden="true"><use href="icons.svg#blocks"></use></svg>Blocks</a></li>
      <li><a href="https://github.com/moji2002/fertig"><svg class="icon" aria-hidden="true"><use href="icons.svg#git-branch"></use></svg>GitHub</a></li>
    </ul>
    <button data-size="sm" data-icon data-theme-toggle aria-label="Switch theme"><svg class="icon sun" aria-hidden="true"><use href="icons.svg#sun"></use></svg><svg class="icon moon" aria-hidden="true"><use href="icons.svg#moon"></use></svg></button>
  </div>
</nav>

{{ content | safe }}
</html>
