---
import SiteLayout from "../layouts/SiteLayout.astro";
import TabDemo from "../components/TabDemo.astro";

const title = "Browse Components | fertig";
const description = "Browse every element, component, and utility fertig styles, with live previews and copyable markup.";
---
<SiteLayout
  title={title}
  description={description}
  canonical="components.html"
  active="components"
  pageTitle="Components"
  pageIntro="Every element, component, and utility fertig styles. No classes required — each pattern is addressed by semantic HTML or ARIA attributes."
  langs={["javascript"]}
>
<main id="main-content" class="band" style="border-top:0">
  <div class="wrap">

    <div class="comp-toolbar">
      <div class="comp-filters" role="group" aria-label="Filter by category">
        <button class="comp-filter" aria-pressed="true" data-filter="all">All</button>
        <button class="comp-filter" aria-pressed="false" data-filter="elements">Elements</button>
        <button class="comp-filter" aria-pressed="false" data-filter="forms">Forms</button>
        <button class="comp-filter" aria-pressed="false" data-filter="buttons">Buttons</button>
        <button class="comp-filter" aria-pressed="false" data-filter="data">Data</button>
        <button class="comp-filter" aria-pressed="false" data-filter="feedback">Feedback</button>
        <button class="comp-filter" aria-pressed="false" data-filter="navigation">Navigation</button>
        <button class="comp-filter" aria-pressed="false" data-filter="overlay">Overlay</button>
        <button class="comp-filter" aria-pressed="false" data-filter="layout">Layout</button>
      </div>
      <div class="comp-search-wrap">
        <input type="search" class="comp-search" placeholder="Search components…" aria-label="Search components" autocomplete="off">
      </div>
    </div>

    <p class="comp-count" role="status" aria-live="polite"><span id="comp-count-num">38</span> components</p>

    <h2 class="sr-only">All components</h2>
    <div class="comp-grid" id="comp-grid">

      <!-- Typography -->
      <article class="comp-card" data-category="elements" data-name="typography">
        <div class="comp-card-head">
          <h3>Typography</h3>
          <span class="badge">elements</span>
        </div>
        <div class="comp-card-preview">
          <p>Body text with <strong>bold</strong>, <em>italic</em>, <a href="#">links</a>, and <code>inline code</code>.</p>
        </div>
        <p class="comp-card-desc">Semantic inline elements are styled directly — strong, em, a, mark, s, ins, abbr, code, kbd, samp. No classes needed.</p>
        <div class="comp-card-code"><code class="language-html">&lt;p&gt;Text with &lt;strong&gt;bold&lt;/strong&gt;, &lt;em&gt;italic&lt;/em&gt;, &lt;a&gt;links&lt;/a&gt;.&lt;/p&gt;</code></div>
      </article>

      <!-- Headings -->
      <article class="comp-card" data-category="elements" data-name="headings">
        <div class="comp-card-head">
          <h3>Headings</h3>
          <span class="badge">elements</span>
        </div>
        <div class="comp-card-preview">
          <h4 style="margin:0">Heading h4</h4>
          <h5 style="margin:0">Heading h5</h5>
        </div>
        <p class="comp-card-desc">h1–h4 descend in size; h5 and h6 become small uppercase labels, which is how they are usually used in practice.</p>
        <div class="comp-card-code"><code class="language-html">&lt;h1&gt;…&lt;/h1&gt; through &lt;h6&gt;…&lt;/h6&gt;</code></div>
      </article>

      <!-- Lists -->
      <article class="comp-card" data-category="elements" data-name="lists">
        <div class="comp-card-head">
          <h3>Lists</h3>
          <span class="badge">elements</span>
        </div>
        <div class="comp-card-preview">
          <ul style="margin:0"><li>Unordered list</li><li>Second item</li></ul>
        </div>
        <p class="comp-card-desc">Ordered, unordered, and definition lists. Description lists become a two-column grid automatically.</p>
        <div class="comp-card-code"><code class="language-html">&lt;ul&gt;&lt;li&gt;Item&lt;/li&gt;&lt;/ul&gt;
&lt;dl&gt;&lt;dt&gt;Key&lt;/dt&gt;&lt;dd&gt;Value&lt;/dd&gt;&lt;/dl&gt;</code></div>
      </article>

      <!-- Blockquote -->
      <article class="comp-card" data-category="elements" data-name="blockquote">
        <div class="comp-card-head">
          <h3>Blockquote</h3>
          <span class="badge">elements</span>
        </div>
        <div class="comp-card-preview">
          <blockquote style="margin:0">A quoted passage with an accent rule and muted text.</blockquote>
        </div>
        <p class="comp-card-desc">Block quotes take an accent rule on the start edge and mute their text colour.</p>
        <div class="comp-card-code"><code class="language-html">&lt;blockquote&gt;…&lt;/blockquote&gt;</code></div>
      </article>

      <!-- Code blocks -->
      <article class="comp-card" data-category="elements" data-name="code">
        <div class="comp-card-head">
          <h3>Code</h3>
          <span class="badge">elements</span>
        </div>
        <div class="comp-card-preview">
          <pre style="margin:0"><code class="language-css">.card &#123; border-radius: var(--fertig-r) &#125;</code></pre>
        </div>
        <p class="comp-card-desc">Inline code, keyboard shortcuts, sample output, and code blocks — all with a monospace face and recessed background.</p>
        <div class="comp-card-code"><code class="language-html">&lt;code&gt;inline&lt;/code&gt;
&lt;pre&gt;&lt;code&gt;block&lt;/code&gt;&lt;/pre&gt;
&lt;kbd&gt;Enter&lt;/kbd&gt;</code></div>
      </article>

      <!-- Links -->
      <article class="comp-card" data-category="elements" data-name="links">
        <div class="comp-card-head">
          <h3>Links</h3>
          <span class="badge">elements</span>
        </div>
        <div class="comp-card-preview">
          <p style="margin:0"><a href="#">A link in the accent colour</a></p>
        </div>
        <p class="comp-card-desc">Links use the accent colour with an underline offset. Add .primary when a prominent navigation link needs button-like styling.</p>
        <div class="comp-card-code"><code class="language-html">&lt;a href="#"&gt;Link text&lt;/a&gt;
&lt;a class="primary" href="/docs"&gt;Read the docs&lt;/a&gt;</code></div>
      </article>

      <!-- Tables -->
      <article class="comp-card" data-category="data" data-name="tables">
        <div class="comp-card-head">
          <h3>Tables</h3>
          <span class="badge">data</span>
        </div>
        <div class="comp-card-preview">
          <table style="margin:0">
            <thead><tr><th>Name</th><th align="right">Size</th></tr></thead>
            <tbody>
              <tr><td>fertig</td><td align="right">9.3 KB</td></tr>
              <tr><td>Other</td><td align="right">12 KB</td></tr>
            </tbody>
          </table>
        </div>
        <p class="comp-card-desc">Editorial tables with hairline rules, hover tint, and self-scrolling on narrow screens. Numbers right-align with align="right".</p>
        <div class="comp-card-code"><code class="language-html">&lt;table&gt;
  &lt;thead&gt;&lt;tr&gt;&lt;th&gt;…&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;
  &lt;tbody&gt;&lt;tr&gt;&lt;td&gt;…&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;
&lt;/table&gt;</code></div>
      </article>

      <!-- Cards -->
      <article class="comp-card" data-category="data" data-name="cards">
        <div class="comp-card-head">
          <h3>Cards</h3>
          <span class="badge">data</span>
        </div>
        <div class="comp-card-preview">
          <div class="card" style="margin:0">
            <header>Card title</header>
            <p style="margin:0">Raised panel with optional header and footer.</p>
          </div>
        </div>
        <p class="comp-card-desc">Raised panels taking optional header and footer that bleed to its edges. Cards are columns — footers align across a row.</p>
        <div class="comp-card-code"><code class="language-html">&lt;div class="card"&gt;
  &lt;header&gt;Title&lt;/header&gt;
  &lt;p&gt;Content.&lt;/p&gt;
  &lt;footer&gt;Meta&lt;/footer&gt;
&lt;/div&gt;</code></div>
      </article>

      <!-- Badges -->
      <article class="comp-card" data-category="data" data-name="badges">
        <div class="comp-card-head">
          <h3>Badges</h3>
          <span class="badge">data</span>
        </div>
        <div class="comp-card-preview">
          <p class="row" style="margin:0">
            <span class="badge">default</span>
            <span class="badge" data-tone="ok">passing</span>
            <span class="badge" data-tone="err">failing</span>
          </p>
        </div>
        <p class="comp-card-desc">Small pill labels for status, counts, or categories. Combine with data-tone for ok/warn/err colours.</p>
        <div class="comp-card-code"><code class="language-html">&lt;span class="badge"&gt;default&lt;/span&gt;
&lt;span class="badge" data-tone="ok"&gt;pass&lt;/span&gt;
&lt;span class="badge" data-tone="err"&gt;fail&lt;/span&gt;</code></div>
      </article>

      <!-- Skeleton -->
      <article class="comp-card" data-category="data" data-name="skeleton">
        <div class="comp-card-head">
          <h3>Skeleton</h3>
          <span class="badge">data</span>
        </div>
        <div class="comp-card-preview">
          <p data-skeleton style="margin:0">This paragraph is a skeleton placeholder.</p>
        </div>
        <p class="comp-card-desc">Placeholder shapes that show where content will appear once it finishes loading, reducing perceived wait time.</p>
        <div class="comp-card-code"><code class="language-html">&lt;p data-skeleton&gt;Loading text…&lt;/p&gt;</code></div>
      </article>

      <!-- Surface -->
      <article class="comp-card" data-category="layout" data-name="surface panel elevation">
        <div class="comp-card-head">
          <h3>Surface</h3>
          <span class="badge">layout</span>
        </div>
        <div class="comp-card-preview">
          <section data-surface style="margin:0">
            <strong>Workspace ready</strong>
            <p class="muted">A quiet elevated region without card anatomy.</p>
          </section>
        </div>
        <p class="comp-card-desc">A general-purpose surface with shared radius and elevation tokens. Use flat or outline when hierarchy should be quieter.</p>
        <div class="comp-card-code"><code class="language-html">&lt;section data-surface&gt;…&lt;/section&gt;
&lt;section data-surface="flat"&gt;…&lt;/section&gt;
&lt;section data-surface="outline"&gt;…&lt;/section&gt;</code></div>
      </article>

      <!-- Item -->
      <article class="comp-card" data-category="data" data-name="item avatar action list row">
        <div class="comp-card-head">
          <h3>Item</h3>
          <span class="badge">data</span>
        </div>
        <div class="comp-card-preview">
          <div data-surface="flat" style="margin:0;padding:.35rem">
            <div data-item>
              <span data-avatar="sm">AM</span>
              <div><strong>Ada Morris</strong><small class="muted">Product design</small></div>
              <button data-icon aria-label="More actions">•••</button>
            </div>
          </div>
        </div>
        <p class="comp-card-desc">A compound row for an avatar or icon, flexible content, and an optional trailing action. It also works on links and buttons.</p>
        <div class="comp-card-code"><code class="language-html">&lt;div data-item&gt;
  &lt;span data-avatar="sm"&gt;AM&lt;/span&gt;
  &lt;div&gt;&lt;strong&gt;Ada Morris&lt;/strong&gt;&lt;small&gt;Product design&lt;/small&gt;&lt;/div&gt;
  &lt;button data-icon aria-label="More actions"&gt;•••&lt;/button&gt;
&lt;/div&gt;</code></div>
      </article>

      <!-- Empty state -->
      <article class="comp-card" data-category="feedback" data-name="empty state blank slate">
        <div class="comp-card-head">
          <h3>Empty State</h3>
          <span class="badge">feedback</span>
        </div>
        <div class="comp-card-preview">
          <section data-empty style="margin:0">
            <span data-avatar aria-hidden="true">+</span>
            <h4>No projects yet</h4>
            <p class="muted">Create a project to start organizing your work.</p>
            <button class="primary">Create project</button>
          </section>
        </div>
        <p class="comp-card-desc">A deliberate endpoint for a collection with no content. Keep one clear explanation and one primary recovery action.</p>
        <div class="comp-card-code"><code class="language-html">&lt;section data-empty&gt;
  &lt;h3&gt;No projects yet&lt;/h3&gt;
  &lt;p&gt;Create one to get started.&lt;/p&gt;
  &lt;button class="primary"&gt;Create project&lt;/button&gt;
&lt;/section&gt;</code></div>
      </article>

      <!-- Input -->
      <article class="comp-card" data-category="forms" data-name="input">
        <div class="comp-card-head">
          <h3>Input</h3>
          <span class="badge">forms</span>
        </div>
        <div class="comp-card-preview">
          <form style="margin:0">
            <label for="c-email">Email</label>
            <input id="c-email" type="email" placeholder="you@example.com">
          </form>
        </div>
        <p class="comp-card-desc">Single-line text fields with labels, placeholders, hints, and validation. Errors fire on :user-invalid after input.</p>
        <div class="comp-card-code"><code class="language-html">&lt;label for="e"&gt;Email&lt;/label&gt;
&lt;input id="e" type="email" required&gt;</code></div>
      </article>

      <!-- Field and input group -->
      <article class="comp-card" data-category="forms" data-name="field input group addon validation">
        <div class="comp-card-head">
          <h3>Field &amp; Input Group</h3>
          <span class="badge">forms</span>
        </div>
        <div class="comp-card-preview">
          <div data-field>
            <label for="c-workspace">Workspace URL</label>
            <div data-input-group>
              <span>https://</span>
              <input id="c-workspace" aria-describedby="c-workspace-help" placeholder="acme">
              <span>.com</span>
            </div>
            <small id="c-workspace-help">Lowercase letters and numbers work best.</small>
          </div>
        </div>
        <p class="comp-card-desc">data-field keeps labels, help, and errors together. data-input-group gives fields, addons, and compact actions one focus surface.</p>
        <div class="comp-card-code"><code class="language-html">&lt;div data-field&gt;
  &lt;label for="workspace"&gt;Workspace URL&lt;/label&gt;
  &lt;div data-input-group&gt;
    &lt;span&gt;https://&lt;/span&gt;
    &lt;input id="workspace" aria-describedby="workspace-help"&gt;
    &lt;span&gt;.com&lt;/span&gt;
  &lt;/div&gt;
  &lt;small id="workspace-help"&gt;Lowercase letters and numbers.&lt;/small&gt;
&lt;/div&gt;</code></div>
      </article>

      <!-- One-time code -->
      <article class="comp-card" data-category="forms" data-name="one time code otp verification">
        <div class="comp-card-head">
          <h3>One-time Code</h3>
          <span class="badge">forms</span>
        </div>
        <div class="comp-card-preview">
          <div data-field>
            <label for="c-code">Verification code</label>
            <input id="c-code" data-otp inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" placeholder="000000" aria-describedby="c-code-help">
            <small id="c-code-help">Enter the six-digit code.</small>
          </div>
        </div>
        <p class="comp-card-desc">A single native input styled like a code control, preserving paste, password-manager, autofill, and screen-reader behavior.</p>
        <div class="comp-card-code"><code class="language-html">&lt;label for="code"&gt;Verification code&lt;/label&gt;
&lt;input id="code" data-otp inputmode="numeric"
  autocomplete="one-time-code" maxlength="6"&gt;</code></div>
      </article>

      <!-- Select -->
      <article class="comp-card" data-category="forms" data-name="select">
        <div class="comp-card-head">
          <h3>Select</h3>
          <span class="badge">forms</span>
        </div>
        <div class="comp-card-preview">
          <form style="margin:0">
            <label for="c-plan">Plan</label>
            <select id="c-plan"><option>Free</option><option>Pro</option></select>
          </form>
        </div>
        <p class="comp-card-desc">Native select dropdown with a CSS-drawn chevron. Supports appearance: base-select on Chromium for full styling.</p>
        <div class="comp-card-code"><code class="language-html">&lt;label for="s"&gt;Plan&lt;/label&gt;
&lt;select id="s"&gt;&lt;option&gt;Free&lt;/option&gt;&lt;/select&gt;</code></div>
      </article>

      <!-- Listbox -->
      <article class="comp-card" data-category="navigation" data-name="listbox option select command menu">
        <div class="comp-card-head">
          <h3>Listbox</h3>
          <span class="badge">navigation</span>
        </div>
        <div class="comp-card-preview">
          <ul role="listbox" tabindex="0" aria-label="Assignee" aria-activedescendant="c-option-ada" style="margin:0">
            <li role="option" id="c-option-ada" aria-selected="true"><span data-avatar="sm">AM</span>Ada Morris</li>
            <li role="option" id="c-option-lin" aria-selected="false"><span data-avatar="sm">LK</span>Lin Kim</li>
            <li role="option" id="c-option-sam" aria-selected="false"><span data-avatar="sm">SR</span>Sam Rivera</li>
          </ul>
        </div>
        <p class="comp-card-desc">A selectable collection styled through ARIA. JavaScript must own selection, active-descendant state, typeahead, and arrow keys.</p>
        <div class="comp-card-code"><code class="language-html">&lt;ul role="listbox" tabindex="0" aria-label="Assignee"
  aria-activedescendant="option-ada"&gt;
  &lt;li id="option-ada" role="option" aria-selected="true"&gt;Ada&lt;/li&gt;
  &lt;li id="option-lin" role="option" aria-selected="false"&gt;Lin&lt;/li&gt;
&lt;/ul&gt;</code></div>
      </article>

      <!-- Textarea -->
      <article class="comp-card" data-category="forms" data-name="textarea">
        <div class="comp-card-head">
          <h3>Textarea</h3>
          <span class="badge">forms</span>
        </div>
        <div class="comp-card-preview">
          <form style="margin:0">
            <label for="c-notes">Notes</label>
            <textarea id="c-notes" placeholder="Grows as you type…" rows="2"></textarea>
          </form>
        </div>
        <p class="comp-card-desc">Multi-line text input with optional resizing and field-sizing: content for auto-grow.</p>
        <div class="comp-card-code"><code class="language-html">&lt;label for="t"&gt;Notes&lt;/label&gt;
&lt;textarea id="t" placeholder="Type here…"&gt;&lt;/textarea&gt;</code></div>
      </article>

      <!-- Checkbox, Radio & Switch -->
      <article class="comp-card" data-category="forms" data-name="checkbox radio switch toggle">
        <div class="comp-card-head">
          <h3>Checkbox, Radio &amp; Switch</h3>
          <span class="badge">forms</span>
        </div>
        <div class="comp-card-preview">
          <form style="margin:0">
            <p><label><input type="checkbox" checked> Checkbox</label></p>
            <p><label><input type="radio" name="cr" checked> Radio</label></p>
            <p><label><input type="checkbox" role="switch" checked> Email updates</label></p>
          </form>
        </div>
        <p class="comp-card-desc">Check options, select one choice, or expose a clear on/off setting. Every control inherits the active accent.</p>
        <div class="comp-card-code"><code class="language-html">&lt;label&gt;&lt;input type="checkbox"&gt; Check&lt;/label&gt;
&lt;label&gt;&lt;input type="radio" name="r"&gt; Radio&lt;/label&gt;
&lt;label&gt;
  &lt;input type="checkbox" role="switch" checked&gt;
  Email updates
&lt;/label&gt;</code></div>
      </article>

      <!-- Range & Progress -->
      <article class="comp-card" data-category="forms" data-name="range progress">
        <div class="comp-card-head">
          <h3>Range &amp; Progress</h3>
          <span class="badge">forms</span>
        </div>
        <div class="comp-card-preview">
          <form style="margin:0">
            <label for="c-range">Volume</label>
            <input id="c-range" type="range" value="60">
            <progress value="0.6"></progress>
          </form>
        </div>
        <p class="comp-card-desc">Range sliders for numeric values within a range. Progress bars show determinate fill for ongoing operations.</p>
        <div class="comp-card-code"><code class="language-html">&lt;input type="range" value="60"&gt;
&lt;progress value="0.6"&gt;&lt;/progress&gt;</code></div>
      </article>

      <!-- Fieldset -->
      <article class="comp-card" data-category="forms" data-name="fieldset">
        <div class="comp-card-head">
          <h3>Fieldset</h3>
          <span class="badge">forms</span>
        </div>
        <div class="comp-card-preview">
          <form style="margin:0">
            <fieldset>
              <legend>Account</legend>
              <label for="c-name">Name</label>
              <input id="c-name" type="text" value="Ada">
            </fieldset>
          </form>
        </div>
        <p class="comp-card-desc">Groups related form controls. The legend is styled as a panel title rather than notching the border.</p>
        <div class="comp-card-code"><code class="language-html">&lt;fieldset&gt;
  &lt;legend&gt;Account&lt;/legend&gt;
  &lt;label for="n"&gt;Name&lt;/label&gt;
  &lt;input id="n" type="text"&gt;
&lt;/fieldset&gt;</code></div>
      </article>

      <!-- Default button -->
      <article class="comp-card" data-category="buttons" data-name="button">
        <div class="comp-card-head">
          <h3>Button</h3>
          <span class="badge">buttons</span>
        </div>
        <div class="comp-card-preview">
          <p class="row" style="margin:0">
            <button>Default</button>
            <button class="primary">Primary</button>
          </p>
        </div>
        <p class="comp-card-desc">A plain button is already styled. type="submit" gets the filled treatment automatically — most forms need no attributes.</p>
        <div class="comp-card-code"><code class="language-html">&lt;button&gt;Default&lt;/button&gt;
&lt;button class="primary"&gt;Primary&lt;/button&gt;</code></div>
      </article>

      <!-- Button variants -->
      <article class="comp-card" data-category="buttons" data-name="soft outline ghost link button variants">
        <div class="comp-card-head">
          <h3>Button Variants</h3>
          <span class="badge">buttons</span>
        </div>
        <div class="comp-card-preview">
          <p class="row" style="margin:0">
            <button data-variant="soft">Soft</button>
            <button data-variant="outline">Outline</button>
            <button data-variant="ghost">Ghost</button>
            <button data-variant="link">Link</button>
          </p>
        </div>
        <p class="comp-card-desc">Soft and outline add hierarchy without another filled action. Ghost and link variants step down further.</p>
        <div class="comp-card-code"><code class="language-html">&lt;button data-variant="soft"&gt;Soft&lt;/button&gt;
&lt;button data-variant="outline"&gt;Outline&lt;/button&gt;
&lt;button data-variant="ghost"&gt;Ghost&lt;/button&gt;
&lt;button data-variant="link"&gt;Link&lt;/button&gt;</code></div>
      </article>

      <!-- Button sizes -->
      <article class="comp-card" data-category="buttons" data-name="button size">
        <div class="comp-card-head">
          <h3>Button Sizes</h3>
          <span class="badge">buttons</span>
        </div>
        <div class="comp-card-preview">
          <p class="row" style="margin:0">
            <button data-size="sm">Small</button>
            <button>Medium</button>
            <button data-size="lg">Large</button>
          </p>
        </div>
        <p class="comp-card-desc">Three sizes via data-size: sm, default, lg. Also supports data-block for full width and data-icon for icon-only.</p>
        <div class="comp-card-code"><code class="language-html">&lt;button data-size="sm"&gt;Small&lt;/button&gt;
&lt;button data-size="lg"&gt;Large&lt;/button&gt;
&lt;button data-block&gt;Full width&lt;/button&gt;</code></div>
      </article>

      <!-- Toned button -->
