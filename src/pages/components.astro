<script>
document.addEventListener("DOMContentLoaded", () => {
  const grid = document.getElementById("comp-grid");
  const cards = [...grid.querySelectorAll(".comp-card")];
  const countEl = document.getElementById("comp-count-num");
  const emptyEl = grid.nextElementSibling;
  const search = document.querySelector(".comp-search");
  const filters = [...document.querySelectorAll(".comp-filter")];
  let active = "all";

  const update = () => {
    const q = search.value.toLowerCase().trim();
    let shown = 0;
    cards.forEach(card => {
      const cat = card.dataset.category;
      const name = card.dataset.name;
      const text = card.textContent.toLowerCase();
      const matchCat = active === "all" || cat === active;
      const matchQ = !q || name.includes(q) || text.includes(q);
      const visible = matchCat && matchQ;
      card.hidden = !visible;
      if (visible) shown++;
    });
    countEl.textContent = shown;
    emptyEl.hidden = shown > 0;
  };

  filters.forEach(btn => btn.addEventListener("click", () => {
    filters.forEach(b => b.setAttribute("aria-pressed", "false"));
    btn.setAttribute("aria-pressed", "true");
    active = btn.dataset.filter;
    update();
  }));

  search.addEventListener("input", update);

  document.querySelector(".comp-clear").addEventListener("click", () => {
    search.value = "";
    active = "all";
    filters.forEach(b => b.setAttribute("aria-pressed", b.dataset.filter === "all" ? "true" : "false"));
    update();
  });

  update();
});
</script>
