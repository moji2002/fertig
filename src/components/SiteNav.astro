---
interface Props {
  active?: "index" | "customize" | "docs" | "components" | "blocks" | "playground";
}

const { active } = Astro.props;

const themes = [
  ["base-dark", "dark", "Base dark"],
  ["base-light", "light", "Base light"],
  ["named", "forest", "Forest"],
  ["named", "aqua", "Aqua"],
  ["named", "retro", "Retro"],
  ["named", "coffee", "Coffee"],
  ["named", "night", "Night"],
  ["named", "cyberpunk", "Cyberpunk"],
  ["named", "synthwave", "Synthwave"],
  ["named", "blossom", "Blossom"],
] as const;
---

<a class="skip-link" href="#main-content">Skip to main content</a>
<nav>
  <div class="bar wrap">
    <strong>
      <a href="index.html" aria-current={active === "index" ? "page" : undefined}>
        <img src="favicon.svg" alt="" width="16" height="16" class="mark" />fertig
      </a>
    </strong>
    <ul>
      <li><a href="index.html#customize" aria-current={active === "customize" ? "page" : undefined}>Customise</a></li>
      <li><a href="docs.html" aria-current={active === "docs" ? "page" : undefined}>Docs</a></li>
      <li><a href="components.html" aria-current={active === "components" ? "page" : undefined}>Components</a></li>
      <li><a href="playground.html" aria-current={active === "playground" ? "page" : undefined}>Playground</a></li>
      <li><a href="blocks.html" aria-current={active === "blocks" ? "page" : undefined}>Blocks</a></li>
      <li class="nav-github">
        <a href="https://github.com/moji2002/fertig">GitHub<svg class="icon" aria-hidden="true"><use href="icons.svg#arrow-right"></use></svg></a>
      </li>
    </ul>
    <div class="bar-controls">
      <button
        type="button"
        class="theme-toggle"
        data-theme-toggle
        popovertarget="theme-menu"
        aria-haspopup="menu"
        aria-expanded="false"
        aria-label="Choose a colour theme"
      >
        <svg class="icon" aria-hidden="true"><use href="icons.svg#palette"></use></svg>
        <i class="swatch" aria-hidden="true"></i>
      </button>
      <div id="theme-menu" class="theme-menu" popover="auto" role="menu" aria-label="Colour themes">
        {themes.map(([kind, value, label]) => (
          <button type="button" role="menuitemradio" aria-checked="false" data-theme-pick={value} data-theme-kind={kind}>
            <i class="swatch" aria-hidden="true"></i>{label}
            <svg class="icon" aria-hidden="true"><use href="icons.svg#check"></use></svg>
          </button>
        ))}
      </div>
    </div>
  </div>
</nav>